{
  "name": "@gemini-sdk/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript SDK for gemini-cli",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.4.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.39",
    "@vitest/coverage-v8": "^3.2",
    "fast-check": "^4.6.0",
    "js-yaml": "^4.1.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2"
  },
  "engines": {
    "node": ">=18"
  }
}
