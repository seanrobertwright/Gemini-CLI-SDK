{
  "name": "@lrilai/gemini-cli-sdk",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "TypeScript SDK for gemini-cli",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanrobertwright/Gemini-SDK.git"
  },
  "homepage": "https://seanrobertwright.github.io/Gemini-SDK/",
  "bugs": {
    "url": "https://github.com/seanrobertwright/Gemini-SDK/issues"
  },
  "keywords": [
    "gemini",
    "gemini-cli",
    "sdk",
    "llm",
    "ai"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:live": "vitest run --config vitest.live.config.ts --passWithNoTests",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "prepack": "node -e \"require('node:fs').copyFileSync('../README.md','README.md');require('node:fs').copyFileSync('../LICENSE','LICENSE')\"",
    "postpack": "node -e \"require('node:fs').rmSync('README.md',{force:true});require('node:fs').rmSync('LICENSE',{force:true})\"",
    "gen:errors": "node ../scripts/gen-errors.mjs"
  },
  "dependencies": {
    "semver": "^7.7.4",
    "zod": "^4.3.6",
    "zod-from-json-schema": "^0.5.2"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.39",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^3.2",
    "fast-check": "^4.6.0",
    "js-yaml": "^4.1.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2"
  },
  "engines": {
    "node": ">=18"
  }
}
