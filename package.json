{
  "name": "gemini-sdk-spec",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Phase 1 specification and fixture infrastructure for the Gemini CLI SDK. Not published.",
  "scripts": {
    "validate": "node scripts/validate-fixtures.mjs",
    "validate:all": "node scripts/validate-fixtures.mjs && node scripts/validate-schema-ts.mjs && bash scripts/validate-schema-py.sh && bash scripts/audit-fixtures.sh",
    "docs:dev": "pnpm --filter docs docs:dev",
    "docs:build": "pnpm --filter docs docs:build",
    "docs:typedoc": "typedoc",
    "changeset": "changeset",
    "version-packages": "changeset version && bash scripts/sync-version.sh",
    "ci:publish": "bash scripts/sync-version.sh && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "15.0.4",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.4.0",
    "typedoc-vitepress-theme": "^1.1.0",
    "typescript": "^5.6.3"
  }
}
